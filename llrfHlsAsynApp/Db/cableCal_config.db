record(bo, "$(DEVICE):CALDAC")
{
    field(PINI, "YES")
    field(DESC, "DAC mode for Calibration")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0) calDac_enable")
    field(SCAN, "Passive")
    field(OMSL, "supervisory")
    field(ZNAM, "BKWD_CMPTB")
    field(ONAM, "Calibration")
    info(autosaveFields, "VAL")
}

record(bo, "$(DEVICE):CALDBG0")
{
    field(PINI, "YES")
    field(DESC, "DBG enable AMC0")
