    field(OUT,  "@asyn($(PORT),0) calDbg_enable_A0")
    field(SCAN, "Passive")
    field(OMSL, "supervisory")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    info(autosaveFields, "VAL")
}

