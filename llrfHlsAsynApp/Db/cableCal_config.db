record(ao, "$(DEVICE):CALPULSE_START")
{
    field(PINI, "YES")
    field(DESC, "Calibration Pulse Start in ns")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0) calPulse_start")
    field(OMSL, "supervisory")
    field(SCAN, "Passive")
    field(PREC, "0")
    field(EGU,  "ns")
    info(autosaveFields, "VAL")
}

