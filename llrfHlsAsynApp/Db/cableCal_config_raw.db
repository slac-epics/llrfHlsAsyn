record(longin, "$(DEVICE):CALPULSE_START_RAW")
{
    field(DESC, "calibration pulse start (raw)")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0) rawPulse_start")
    field(SCAN, "I/O Intr")
}

record(longin, "$(DEVICE):CALPULSE_END_RAW")
{
    field(DESC, "calibration pulse end (raw)")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0) rawPulse_end")
    field(SCAN, "I/O Intr")
}

