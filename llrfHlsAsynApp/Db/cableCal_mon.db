record(ai, "$(DEVICE):CALPHASE_P$(P)C$(C)")
{
    field(DESC, "calibration phase for pulse $(P) ch $(C)")
    field(DTYP, "asynFlot64")
    field(INP,  "@asyn($(PORT),0) calPhase_P$(P)C$(C)")
    field(SCAN, "I/O Intr")
    field(PREC, "3")
    field(EGU,  "degree")
}

record(ai, "$(DEVICE):CALAMPL_P$(P)C$(C)")
{
    field(DESC, "calibration amplitude for pulse $(P) ch $(C)")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0) calAmpl_P$(P)C$(C)")
    field(SCAN, "I/O Intr")
    field(PREC, "3")
    field(EGU,  "Normalized")
}

record(longin, "$(DEVICE):CALPHASE_P$(P)C$(C)_RAW")
{
    field(DESC, "calibration phase (raw) for pulse $(P) ch $(C)")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) rawPhase_P$(P)C$(C)")
    field(SCAN, "I/O Intr")
}

record(longin, "$(DEVICE):CALAMPL_P$(P)C$(C)_RAW")
{
    field(DESC, "calibration amplitude (raw) for pulse $(P) ch $(C)")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) rawAmpl_P$(P)C$(C)")
    field(SCAN, "I/O Intr")
}
